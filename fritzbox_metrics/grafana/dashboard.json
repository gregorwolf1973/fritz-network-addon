{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB",
      "description": "InfluxDB 1.x datasource with the fritzbox_metrics database",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "influxdb", "name": "InfluxDB", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "FritzBox WAN",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Connected",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{
        "refId": "A",
        "query": "SELECT last(\"connected\") FROM \"fritzbox_wan\" WHERE $timeFilter",
        "rawQuery": true,
        "resultFormat": "time_series"
      }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{
        "refId": "A",
        "query": "SELECT last(\"uptime_seconds\") FROM \"fritzbox_wan\" WHERE $timeFilter",
        "rawQuery": true,
        "resultFormat": "time_series"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "External IP",
      "gridPos": { "h": 4, "w": 6, "x": 8, "y": 1 },
      "id": 3,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{
        "refId": "A",
        "query": "SELECT last(\"external_ip\") FROM \"fritzbox_wan\" WHERE $timeFilter",
        "rawQuery": true,
        "resultFormat": "time_series"
      }],
      "options": { "colorMode": "none", "graphMode": "none", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "Max Down / Up",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "id": 4,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "alias": "Down",
          "query": "SELECT last(\"downstream_max_bps\") FROM \"fritzbox_wan\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "refId": "B",
          "alias": "Up",
          "query": "SELECT last(\"upstream_max_bps\") FROM \"fritzbox_wan\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bps" } },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "type": "stat",
      "title": "Total Hosts (active)",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "id": 5,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "alias": "Total",
          "query": "SELECT last(\"total\") FROM \"fritzbox_hosts\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "refId": "B",
          "alias": "Active",
          "query": "SELECT last(\"active\") FROM \"fritzbox_hosts\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "type": "timeseries",
      "title": "WAN Throughput (live)",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 5 },
      "id": 6,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "alias": "Down",
          "query": "SELECT mean(\"downstream_current_bps\") FROM \"fritzbox_wan\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "refId": "B",
          "alias": "Up",
          "query": "SELECT mean(\"upstream_current_bps\") FROM \"fritzbox_wan\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "spanNulls": true }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "WAN Bytes Counters",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "id": 7,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "alias": "Sent",
          "query": "SELECT non_negative_derivative(last(\"bytes_sent_total\"), 1s) FROM \"fritzbox_wan\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "refId": "B",
          "alias": "Received",
          "query": "SELECT non_negative_derivative(last(\"bytes_received_total\"), 1s) FROM \"fritzbox_wan\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "spanNulls": true }
        }
      }
    },
    {
      "type": "row",
      "title": "WLAN & Hosts",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "WLAN Clients per Band",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 10,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{
        "refId": "A",
        "query": "SELECT mean(\"clients\") FROM \"fritzbox_wlan\" WHERE $timeFilter GROUP BY time($__interval), \"band\" fill(null)",
        "rawQuery": true,
        "resultFormat": "time_series"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "spanNulls": true, "stacking": { "mode": "normal" } }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Hosts: Total vs Active",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 11,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "alias": "Total",
          "query": "SELECT mean(\"total\") FROM \"fritzbox_hosts\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "refId": "B",
          "alias": "Active",
          "query": "SELECT mean(\"active\") FROM \"fritzbox_hosts\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        }
      }
    },
    {
      "type": "row",
      "title": "Home Assistant Core",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "HA Core Running",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 23 },
      "id": 20,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{
        "refId": "A",
        "query": "SELECT last(\"running\") FROM \"ha_core\" WHERE $timeFilter",
        "rawQuery": true,
        "resultFormat": "time_series"
      }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "type": "timeseries",
      "title": "HA Core CPU %",
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 23 },
      "id": 21,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{
        "refId": "A",
        "query": "SELECT mean(\"cpu_percent\") FROM \"ha_core\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
        "rawQuery": true,
        "resultFormat": "time_series"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "spanNulls": true }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "HA Core Memory %",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 23 },
      "id": 22,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{
        "refId": "A",
        "query": "SELECT mean(\"memory_percent\") FROM \"ha_core\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
        "rawQuery": true,
        "resultFormat": "time_series"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "spanNulls": true }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "HA Core Network RX/TX",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 31 },
      "id": 23,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "alias": "RX",
          "query": "SELECT non_negative_derivative(last(\"network_rx\"), 1s) FROM \"ha_core\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "refId": "B",
          "alias": "TX",
          "query": "SELECT non_negative_derivative(last(\"network_tx\"), 1s) FROM \"ha_core\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        }
      }
    },
    {
      "type": "row",
      "title": "Host & Disk",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 },
      "id": 103,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "gauge",
      "title": "Disk Used",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 39 },
      "id": 30,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "alias": "Used %",
          "query": "SELECT (last(\"disk_used_gb\") / last(\"disk_total_gb\")) * 100 FROM \"ha_host\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Host CPU %",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 39 },
      "id": 31,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{
        "refId": "A",
        "query": "SELECT mean(\"cpu_percent\") FROM \"ha_host\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
        "rawQuery": true,
        "resultFormat": "time_series"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "spanNulls": true }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Host Memory",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 39 },
      "id": 32,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "alias": "Used",
          "query": "SELECT mean(\"memory_used_bytes\") FROM \"ha_host\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "refId": "B",
          "alias": "Total",
          "query": "SELECT mean(\"memory_total_bytes\") FROM \"ha_host\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        }
      }
    },
    {
      "type": "row",
      "title": "Entities & Addons",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 46 },
      "id": 104,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Total Entities",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 47 },
      "id": 40,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{
        "refId": "A",
        "query": "SELECT last(\"total\") FROM \"ha_entities\" WHERE $timeFilter",
        "rawQuery": true,
        "resultFormat": "time_series"
      }],
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "Addons (running / total)",
      "gridPos": { "h": 5, "w": 5, "x": 4, "y": 47 },
      "id": 41,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        {
          "refId": "A",
          "alias": "Running",
          "query": "SELECT last(\"running\") FROM \"ha_addons\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "refId": "B",
          "alias": "Total",
          "query": "SELECT last(\"total\") FROM \"ha_addons\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "type": "bargauge",
      "title": "Entities by Domain",
      "gridPos": { "h": 10, "w": 9, "x": 9, "y": 47 },
      "id": 42,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{
        "refId": "A",
        "query": "SELECT last(\"count\") FROM \"ha_entities_by_domain\" WHERE $timeFilter GROUP BY \"domain\"",
        "rawQuery": true,
        "resultFormat": "time_series"
      }],
      "options": { "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true }
    },
    {
      "type": "piechart",
      "title": "Entities by State",
      "gridPos": { "h": 10, "w": 6, "x": 18, "y": 47 },
      "id": 43,
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{
        "refId": "A",
        "query": "SELECT last(\"count\") FROM \"ha_entities_by_state\" WHERE $timeFilter GROUP BY \"state\"",
        "rawQuery": true,
        "resultFormat": "time_series"
      }],
      "options": { "legend": { "displayMode": "list", "placement": "right" }, "pieType": "donut" }
    }
  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["fritzbox", "homeassistant", "metrics"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "FritzBox & Home Assistant Metrics",
  "uid": "fritzbox-ha-metrics",
  "version": 1,
  "weekStart": ""
}
